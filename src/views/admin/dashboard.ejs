<%- include('../partials/header') %>
<div class="admin-layout">
  <%- include('../partials/admin_sidebar') %>
  <section class="admin-content">
    <div class="admin-page-heading">
      <div><p class="admin-eyebrow">BẢNG ĐIỀU KHIỂN</p><h1>Tổng quan cửa hàng</h1><p>Theo dõi sản phẩm và đơn hàng từ cơ sở dữ liệu.</p></div>
      <a class="btn primary" href="/admin/products">+ Quản lý sản phẩm</a>
    </div>
    <div class="metric-grid">
      <article class="metric-card"><div class="metric-label"><span>Doanh thu đơn hàng</span><span class="metric-icon">↗</span></div><strong><%= summary.revenue.toLocaleString('vi-VN') %>đ</strong><small>Tổng giá trị đơn đã ghi nhận</small></article>
      <article class="metric-card"><div class="metric-label"><span>Tổng đơn hàng</span><span class="metric-icon">▤</span></div><strong><%= summary.orders %></strong><small>Đơn hàng trong hệ thống</small></article>
      <article class="metric-card"><div class="metric-label"><span>Đơn chờ duyệt</span><span class="metric-icon">◷</span></div><strong><%= summary.pending %></strong><small>Cần xử lý</small></article>
      <article class="metric-card"><div class="metric-label"><span>Sản phẩm</span><span class="metric-icon">◇</span></div><strong><%= productCount %></strong><small>Trong đó <%= prebuiltCount %> bộ PC build sẵn</small></article>
    </div>
    <div class="admin-panel">
      <div class="admin-panel-head"><div><h2>Đơn hàng gần đây</h2><p>6 đơn hàng mới nhất</p></div><a href="/admin/orders">Xem tất cả →</a></div>
      <% if (orders.length) { %>
      <div class="admin-table-scroll"><table class="admin-table">
        <thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead>
        <tbody><% orders.forEach((order) => { %><tr>
          <td><strong>#<%= order.id %></strong></td><td><%= order.customer %></td><td><%= order.createdAt %></td>
          <td class="admin-price"><%= order.total.toLocaleString('vi-VN') %>đ</td>
          <td><span class="status-badge <%= order.status === 'Hoàn tất' ? 'done' : order.status === 'Đã hủy' ? 'cancelled' : order.status === 'Đang giao' ? 'shipping' : 'pending' %>"><%= order.status %></span></td>
        </tr><% }) %></tbody>
      </table></div>
      <% } else { %>
        <div class="admin-empty"><span>▤</span><strong>Chưa có đơn hàng nào</strong><p>Khi khách đặt hàng, dữ liệu sẽ xuất hiện tại đây.</p></div>
      <% } %>
    </div>
    <div class="admin-shortcuts">
      <a href="/admin/products"><span>▤</span><strong>Quản lý sản phẩm</strong><small>Thêm, xem, sửa và xóa sản phẩm →</small></a>
      <a href="/admin/orders"><span>▣</span><strong>Quản lý đơn hàng</strong><small>Theo dõi và cập nhật trạng thái →</small></a>
    </div>
  </section>
</div>
<%- include('../partials/footer') %>
