<%- include('../partials/header') %>
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">HIỆU NĂNG · TÙY BIẾN · PHÙ HỢP MỌI NHU CẦU</p>
    <h1>BUILD YOUR<br><span>DREAM PC</span></h1>
    <p>Khám phá linh kiện chính hãng, cấu hình tối ưu hoặc để chúng tôi gợi ý cho bạn bộ PC phù hợp nhất.</p>
    <div class="hero-actions">
      <a class="btn primary" href="/pc-builder">⚙ Tự build PC →</a>
      <a class="btn glass" href="/products?category=PC%20Build%20s%E1%BA%B5n">◇ Xem PC build sẵn →</a>
    </div>
  </div>
  <div class="hero-rig">
    <img src="/uploads/gpu.svg" alt="PC gaming">
    <strong>PC Upgrade Store</strong>
    <span>Hiệu năng mạnh mẽ · Thiết kế hiện đại</span>
  </div>
  <div class="hero-features">
    <div><b>✦ Linh kiện chính hãng</b><span>Bảo hành đầy đủ</span></div>
    <div><b>⚙ Tư vấn cấu hình thông minh</b><span>Phù hợp nhu cầu và ngân sách</span></div>
    <div><b>◇ Mô phỏng lắp PC trực quan</b><span>Trải nghiệm như thật</span></div>
    <div><b>◉ Hỗ trợ khách hàng</b><span>Nhanh chóng, tận tâm</span></div>
  </div>
</section>

<div class="category-row home-categories" role="group" aria-label="Lọc linh kiện theo danh mục">
  <button class="category-chip active" type="button" data-home-category="all" aria-pressed="true">
    <span class="category-icon">✦</span><strong>Tất cả</strong>
  </button>
  <% categories.forEach((category, index) => { %>
    <button class="category-chip" type="button" data-home-category="<%= category %>" aria-pressed="false">
      <span class="category-icon"><%= ['▣','▰','▦','▤','▱','⬡','▥','◉'][index % 8] %></span>
      <strong><%= category %></strong>
    </button>
  <% }) %>
</div>

<div class="home-content">
  <div>
    <section class="section-head">
      <div><h2 id="home-product-title">🔥 Sản phẩm nổi bật</h2><p id="home-product-subtitle">Những linh kiện được ưa chuộng nhất hiện nay</p></div>
      <a href="/products">Xem tất cả →</a>
    </section>
    <div class="product-grid home-products" id="home-product-grid">
      <% const featuredIds = new Set(featuredProducts.map((product) => product.id)); %>
      <% allProducts.forEach((product) => { %>
        <article class="product-card" data-product-category="<%= product.category %>" data-featured="<%= featuredIds.has(product.id) ? 'true' : 'false' %>" <%= featuredIds.has(product.id) ? '' : 'hidden' %>>
          <span class="product-badge"><%= product.category %></span>
          <img src="<%= product.image %>" alt="<%= product.name %>">
          <p class="category"><%= product.category %> · <%= product.brand %></p>
          <h3><%= product.name %></h3>
          <p class="performance">Hiệu năng <strong><%= product.performance %>/100</strong></p>
          <p class="price"><%= product.price.toLocaleString('vi-VN') %>đ</p>
          <div class="card-actions">
            <a class="btn small" href="/products/<%= product.id %>">Xem chi tiết</a>
            <% if (user) { %>
              <form action="/cart/add/<%= product.id %>" method="post"><button class="btn small primary" type="submit">🛒</button></form>
            <% } else { %>
              <a class="btn small primary cart-icon-btn" href="/login">🛒</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
    <p class="empty-state" id="home-products-empty" hidden>Hiện chưa có sản phẩm thuộc danh mục này.</p>

    <section class="section-head prebuilt-head">
      <div><h2>◇ PC Build sẵn</h2><p>Cấu hình tối ưu, sẵn sàng chiến mọi tác vụ</p></div>
      <a href="/products?category=PC%20Build%20s%E1%BA%B5n">Xem tất cả →</a>
    </section>
    <div class="prebuilt-row">
      <% prebuiltProducts.slice(0, 5).forEach((pc, index) => { %>
        <article class="prebuilt-card">
          <img class="prebuilt-image" src="<%= pc.image %>" alt="<%= pc.name %>">
          <div>
            <% if (pc.specs.tier === 'Ultimate') { %><span class="pill ultimate">VIP PRO</span>
            <% } else if (pc.specs.tier === 'Tiet kiem') { %><span class="pill green">Giá rẻ</span>
            <% } else if (index === 0) { %><span class="pill green">Nổi bật</span><% } %>
            <h3><%= pc.name %></h3>
            <p><%= pc.specs.purpose || 'Cấu hình PC hoàn chỉnh' %></p>
            <strong><%= pc.price.toLocaleString('vi-VN') %>đ</strong>
          </div>
          <a class="btn small primary" href="/products/<%= pc.id %>">Xem chi tiết →</a>
        </article>
      <% }) %>
    </div>
    <% if (!prebuiltProducts.length) { %>
      <p class="empty-state">Chưa có PC build sẵn. Chạy lệnh npm run seed:prebuilt để thêm 5 bộ PC.</p>
    <% } %>
  </div>

  <aside class="home-sidebar">
    <div class="side-card prebuilt-promo">
      <div><h2>PC Build sẵn</h2><p>Nhiều cấu hình tối ưu cho Game, Đồ họa, Văn phòng...</p><a class="btn primary small" href="/products?category=PC%20Build%20s%E1%BA%B5n">Xem ngay →</a></div>
      <div class="pc-glow">PC</div>
    </div>
    <div class="side-card ai-promo">
      <span class="ai-label">AI</span>
      <h2>Tư vấn cấu hình với AI</h2>
      <p>Chỉ cần nói nhu cầu và ngân sách, chúng tôi sẽ gợi ý cấu hình phù hợp nhất!</p>
      <button class="btn ai-button" type="button">Chat ngay →</button>
      <div class="bot-face">◉‿◉</div>
    </div>
  </aside>
</div>
<%- include('../partials/footer') %>
